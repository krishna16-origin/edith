# Local Storage
DATA_DIR=~/edith_data

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NVIDIA API (Primary LLM)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI API (Required for Voice STT/TTS only)
OPENAI_API_KEY=your-openai-key

# Twilio (Phone)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15551234567
WEBHOOK_BASE_URL=https://your-domain.com

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Bitwarden (Credential Vault)
BITWARDEN_CLIENT_ID=your-client-id
BITWARDEN_CLIENT_SECRET=your-client-secret

# Email (SMTP or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_FROM=your-email@gmail.com
SENDGRID_API_KEY=sg_...

# Models (NVIDIA NIM models)
DEFAULT_MODEL=meta/llama-3.1-70b-instruct
FAST_MODEL=meta/llama-3.1-8b-instruct
MAX_TOKENS=8192
TEMPERATURE=0.7

# Spend Limits
SPEND_LIMIT_PER_TXN=500.0
SPEND_LIMIT_PER_DAY=2000.0

# Voice (uses OpenAI)
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Logging
LOG_LEVEL=INFO
DEBUG=true