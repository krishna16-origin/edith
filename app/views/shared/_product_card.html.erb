<div class="product-card">
  <%= link_to product_path(product) do %>
    <img class="thumb" src="<%= product.image_url %>" alt="<%= product.name %>">
    <% if product.rating.present? %>
      <span class="rating-badge"><%= number_with_precision(product.rating, precision: 1) %> &#9733;</span>
    <% end %>
    <p class="pname"><%= product.name %></p>
  <% end %>

  <div class="price-row">
    <span class="price-now">&#8377;<%= number_with_delimiter(product.price.to_i) %></span>
    <% if product.discount_percent > 0 %>
      <span class="price-mrp">&#8377;<%= number_with_delimiter(product.mrp.to_i) %></span>
      <span class="price-off"><%= product.discount_percent %>% off</span>
    <% end %>
  </div>

  <% unless product.in_stock? %>
    <span class="out-of-stock-tag">Out of stock</span>
  <% end %>
</div>
