<h2 class="section-title">Checkout</h2>

<div class="cart-layout">
  <div>
    <% @cart_items.each do |item| %>
      <div class="cart-item-row" style="grid-template-columns: 70px 1fr auto;">
        <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>">
        <div>
          <p class="pname"><%= item.product.name %></p>
          <span>Qty: <%= item.quantity %></span>
        </div>
        <strong>&#8377;<%= number_with_delimiter(item.subtotal.to_i) %></strong>
      </div>
    <% end %>

    <%= form_with url: orders_path, method: :post, local: true do %>
      <div class="form-group">
        <label for="address">Delivery address</label>
        <input type="text" id="address" name="address" placeholder="House no, street, city, pincode" required>
      </div>
      <%= submit_tag "Place order", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="summary-card">
    <h3>Order summary</h3>
    <div class="summary-row"><span>Items (<%= current_cart.total_items %>)</span><span>&#8377;<%= number_with_delimiter(current_cart.total_price.to_i) %></span></div>
    <div class="summary-row"><span>Delivery</span><span style="color:var(--gk-green)">Free</span></div>
    <div class="summary-row summary-total"><span>Total</span><span>&#8377;<%= number_with_delimiter(current_cart.total_price.to_i) %></span></div>
  </div>
</div>
