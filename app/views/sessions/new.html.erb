<div class="login-wrapper">
  <div class="login-side">
    <h2>Login</h2>
    <p>Get access to your Orders, Wishlist and Recommendations.</p>
  </div>

  <div class="login-form-area">
    <%= form_with url: login_path, method: :post, local: true do %>
      <div class="form-group">
        <label for="name">Enter your name</label>
        <input type="text" id="name" name="name" value="<%= params[:name] %>" placeholder="e.g. Priya Sharma" required>
      </div>

      <div class="form-group">
        <label for="phone_number">Enter your mobile number</label>
        <input type="tel" id="phone_number" name="phone_number" value="<%= params[:phone_number] %>"
               placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" required>
        <p class="form-hint">No password needed &mdash; your number and name are your login.</p>
      </div>

      <%= submit_tag "Continue", class: "btn btn-primary btn-block" %>
    <% end %>
  </div>
</div>
