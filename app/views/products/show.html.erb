<div class="product-detail">
  <div>
    <img class="thumb-large" src="<%= @product.image_url %>" alt="<%= @product.name %>">
  </div>

  <div>
    <h1><%= @product.name %></h1>
    <span class="rating-badge"><%= number_with_precision(@product.rating, precision: 1) %> &#9733;</span>

    <div class="mrp-row">
      <span class="price-huge">&#8377;<%= number_with_delimiter(@product.price.to_i) %></span>
      <% if @product.discount_percent > 0 %>
        <span class="price-mrp">&#8377;<%= number_with_delimiter(@product.mrp.to_i) %></span>
        <span class="price-off"><%= @product.discount_percent %>% off</span>
      <% end %>
    </div>

    <p class="description"><%= @product.description %></p>

    <% if @product.in_stock? %>
      <p><strong>In stock</strong> &middot; <%= @product.stock %> available</p>
    <% else %>
      <p class="out-of-stock-tag">Currently out of stock</p>
    <% end %>

    <div class="cta-row">
      <% if logged_in? %>
        <%= button_to "Add to cart", add_to_cart_path(product_id: @product.id), method: :post,
              class: "btn btn-secondary", disabled: !@product.in_stock? %>
        <%= button_to "Buy now", add_to_cart_path(product_id: @product.id, buy_now: true), method: :post,
              class: "btn btn-primary", disabled: !@product.in_stock? %>
      <% else %>
        <%= link_to "Login to buy", login_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>

<% if @related.any? %>
  <h3 class="related-title">You may also like</h3>
  <div class="product-grid">
    <% @related.each do |product| %>
      <%= render "shared/product_card", product: product %>
    <% end %>
  </div>
<% end %>
